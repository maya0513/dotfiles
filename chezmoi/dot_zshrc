# Created by newuser for 5.9
export EDITOR=nano
export VISUAL=nano
export PATH="$HOME/.local/bin:$PATH"

bindkey -r '^V'

# /etc/zsh/zshrcが追加するNixのPATHも、miseを有効にする前に外す。
path=("${(@)path:#$HOME/.nix-profile/bin}")
path=("${(@)path:#/nix/*}")

# pnpm
export PNPM_HOME='/home/maya0513/.local/share/pnpm'
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac

# Unity CLI
case ":${PATH}:" in
  *:"$HOME/.local/bin":*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

eval "$("$HOME/.local/bin/mise" activate zsh)"
eval "$(starship init zsh)"
